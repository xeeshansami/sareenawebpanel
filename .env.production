# Production build only — `npm run build`, and therefore `npm run deploy`.
#
# This file exists because .env.local overrides .env in EVERY mode, build
# included. A developer with a .env.local pointing at localhost:3000 would
# otherwise ship a GitHub Pages bundle that calls their own machine, and the
# deployed panel would fail for everyone with no error that names the cause.
#
# Vite loads .env, then .env.local, then .env.[mode] — later wins — so a
# mode-specific file is the one thing a local override cannot beat.
VITE_API_BASE_URL=https://sareenanodeserver.vercel.app/api/v1
VITE_APP_NAME=PartHub
