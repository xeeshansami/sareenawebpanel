# Copy to .env.local to override the API this panel talks to.
#
# .env.local is git-ignored and overrides .env in every mode, so it is per
# machine and never shipped. The value below is the deployed API — the same one
# .env uses — which is the right default now that the backend is live.
#
# To develop against a backend running on this machine, change it to:
#   VITE_API_BASE_URL=http://localhost:3000/api/v1
# A route you add locally but have not deployed answers "Route ... not found"
# until you do, which is the symptom this file exists to explain.
#
# Production builds ignore all of this: .env.production wins over .env.local.
VITE_API_BASE_URL=https://sareenanodeserver.vercel.app/api/v1
